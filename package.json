{
  "name": "crypto-portfolio-monitoring-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:isolated": "node scripts/run-isolated-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:unit:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:integration:watch": "vitest --config vitest.integration.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:xs": "playwright test --project=xs-mobile",
    "test:e2e:responsive": "playwright test --config playwright.responsive.config.ts",
    "test:e2e:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "ci:verify": "npm run test && npm run build:isolated",
    "audit:high": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:snyk": "snyk test --severity-threshold=high",
    "security:deps": "npm run audit:high",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build:isolated",
    "quality:ci": "npm ci && npm run lint && npm run typecheck && npm run test && npm run build:isolated && npm run security:deps"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.8",
    "echarts": "^6.0.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.8.0",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.8.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.1",
    "msw": "^2.14.6",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  }
}
