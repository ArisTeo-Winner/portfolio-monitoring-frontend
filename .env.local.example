NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Name of the HttpOnly refresh-token cookie the backend sets on /api/v1/auth/login.
# The BFF (src/app/api/auth/login) reads it from the backend's Set-Cookie and
# re-issues it as the first-party `cpm.rt` cookie. Server-only (no NEXT_PUBLIC_).
BACKEND_REFRESH_COOKIE=refresh_token
